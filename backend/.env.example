# Development environment (copy to .env and fill in values)
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3001
APP_URL=http://localhost:3001
DATABASE_URL=postgresql://siwes:siwes123@localhost:5432/siwes_connect

# Auth
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_REFRESH_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Coordinator invite code
COORDINATOR_INVITE_CODE=coord_2024_invite

# Email (optional - SendGrid)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@siwesconnect.ng
FROM_NAME=SIWES Connect

# File uploads (optional - Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
